  "author": "Graefer",
  "homepage": "https://github.com/Graefer/node-red-contrib-waterkotte#readme",
  "bugs": {
    "url": "https://github.com/Graefer/node-red-contrib-waterkotte/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Graefer/node-red-contrib-waterkotte.git"
  },
  "node-red": {
    "nodes": {
      "waterkotte-config": "nodes/waterkotte-config.js",
      "waterkotte-read":   "nodes/waterkotte-read.js"
    }
  },
  "files": [
    "nodes/",
    "lib/",
    "examples/",
    "LICENSE",
    "README.md"
  ],
